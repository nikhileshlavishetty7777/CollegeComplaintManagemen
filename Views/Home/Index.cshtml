@{
    ViewData["Title"] = "Home";
    var dashboardController = User.IsInRole("Admin") ? "Admin" : "Complaints";
}

<!-- Hero -->
<section class="hero">
    <div class="container text-center">

        <img src="~/images/utu.jpg"
             alt="College Logo"
             class="college-logo" />

        <h1 class="display-5 fw-bold mt-3">
            College Complaint Management System
        </h1>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-light btn-lg text-primary fw-semibold px-4"
               asp-controller="@dashboardController"
               asp-action="Dashboard">
                <i class="bi bi-speedometer2 me-2"></i>
                Go to Dashboard
            </a>
        }
        else
        {
            <a class="btn btn-light btn-lg text-primary fw-semibold px-4 me-2 mb-2"
               asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Login
            </a>

            <a class="btn btn-outline-light btn-lg px-4 mb-2"
               asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus me-2"></i>
                Register
            </a>
        }

    </div>
</section>
<!-- Features -->
<section id="features" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Features</h2>
            <p class="text-muted">Everything you need to raise and resolve campus issues.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card feature-card h-100 text-center p-3">
                    <div class="card-body">
                        <div class="feature-icon"><i class="bi bi-pencil-square"></i></div>
                        <h5 class="card-title">Easy Submission</h5>
                        <p class="card-text text-muted">Submit a complaint in under a minute by choosing a category and describing the issue.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card feature-card h-100 text-center p-3">
                    <div class="card-body">
                        <div class="feature-icon"><i class="bi bi-upc-scan"></i></div>
                        <h5 class="card-title">Unique Tracking Number</h5>
                        <p class="card-text text-muted">Every complaint gets its own tracking number so you can follow it from start to finish.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card feature-card h-100 text-center p-3">
                    <div class="card-body">
                        <div class="feature-icon"><i class="bi bi-graph-up-arrow"></i></div>
                        <h5 class="card-title">Live Status Updates</h5>
                        <p class="card-text text-muted">See whether your complaint is Pending, In Progress or Resolved at any time.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card feature-card h-100 text-center p-3">
                    <div class="card-body">
                        <div class="feature-icon"><i class="bi bi-chat-left-text"></i></div>
                        <h5 class="card-title">Admin Remarks</h5>
                        <p class="card-text text-muted">Administrators reply with remarks so you know what action is being taken.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card feature-card h-100 text-center p-3">
                    <div class="card-body">
                        <div class="feature-icon"><i class="bi bi-shield-lock"></i></div>
                        <h5 class="card-title">Secure &amp; Private</h5>
                        <p class="card-text text-muted">Passwords are hashed and students can only see their own complaints.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card feature-card h-100 text-center p-3">
                    <div class="card-body">
                        <div class="feature-icon"><i class="bi bi-phone"></i></div>
                        <h5 class="card-title">Works on Every Device</h5>
                        <p class="card-text text-muted">A responsive design that works on mobile, tablet and desktop.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Process -->
<section id="process" class="py-5 bg-soft">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">How the Complaint Process Works</h2>
            <p class="text-muted">Four simple steps from problem to resolution.</p>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-6 col-lg-3">
                <div class="process-step">
                    <div class="step-number">1</div>
                    <h6 class="mt-3">Register &amp; Login</h6>
                    <p class="small text-muted mb-0">Create a student account with your college email.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="process-step">
                    <div class="step-number">2</div>
                    <h6 class="mt-3">Submit Complaint</h6>
                    <p class="small text-muted mb-0">Pick a category, add a title and describe the issue.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="process-step">
                    <div class="step-number">3</div>
                    <h6 class="mt-3">Admin Review</h6>
                    <p class="small text-muted mb-0">An administrator reviews it and updates the status.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="process-step">
                    <div class="step-number">4</div>
                    <h6 class="mt-3">Track &amp; Resolve</h6>
                    <p class="small text-muted mb-0">Follow progress with your tracking number until it is resolved.</p>
                </div>
            </div>
        </div>
    </div>
</section>
