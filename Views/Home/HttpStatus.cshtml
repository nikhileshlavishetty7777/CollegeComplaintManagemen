@{
    ViewData["Title"] = ViewData["Heading"] as string;
}

<div class="container py-5 text-center">
    <div class="error-code">@ViewData["Code"]</div>
    <h2 class="fw-bold">@ViewData["Heading"]</h2>
    <p class="text-muted mb-4">@ViewData["Message"]</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-2"></i>Back to Home
    </a>
</div>
