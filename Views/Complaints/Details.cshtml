@model Complaint
@{
    ViewData["Title"] = "Complaint Details";
}

<div class="page-header mb-4">
    <h3 class="mb-1">Complaint Details</h3>
    <p class="text-muted mb-0">Tracking number <strong>@Model.TrackingNumber</strong></p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0">@Model.Title</h5>
                <partial name="_StatusBadge" model="Model.Status" />
            </div>
            <div class="card-body p-4">
                <div class="detail-label">Description</div>
                <div class="description-box mb-4">@Model.Description</div>

                <div class="detail-label">Administrator Remarks</div>
                @if (!string.IsNullOrWhiteSpace(Model.AdminRemarks))
                {
                    <div class="remarks-box"><i class="bi bi-chat-left-quote me-2"></i>@Model.AdminRemarks</div>
                }
                else
                {
                    <div class="text-muted fst-italic">No remarks from the administrator yet.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Summary</h6>

                <div class="detail-label">Tracking Number</div>
                <div class="mb-3 fw-semibold">@Model.TrackingNumber</div>

                <div class="detail-label">Category</div>
                <div class="mb-3">@Model.Category</div>

                <div class="detail-label">Submitted On</div>
                <div class="mb-3">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>

                <div class="detail-label">Last Updated</div>
                <div class="mb-0">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a class="btn btn-outline-primary" asp-action="MyComplaints">
        <i class="bi bi-arrow-left me-2"></i>Back to My Complaints
    </a>
</div>
