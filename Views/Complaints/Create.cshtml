@model CreateComplaintViewModel
@{
    ViewData["Title"] = "Submit Complaint";
}

<div class="page-header mb-4">
    <h3 class="mb-1">Submit a Complaint</h3>
    <p class="text-muted mb-0">Describe your issue clearly so it can be resolved quickly.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select"
                                asp-items="@(new SelectList(ComplaintCategories.All))">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="Short summary of the problem" maxlength="150" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6" maxlength="2000"
                                  placeholder="Explain what happened, where, and when..."></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Description" class="text-danger small"></span>
                            <span class="form-text ms-auto"><span id="descCounter">0</span> / 2000</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-2"></i>Submit Complaint
                        </button>
                        <button type="reset" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Reset
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold"><i class="bi bi-lightbulb me-2 text-warning"></i>Tips</h6>
                <ul class="small text-muted ps-3 mb-0">
                    <li>Choose the category that matches your issue.</li>
                    <li>Use a clear title, for example "Projector not working in Room 204".</li>
                    <li>Mention the location, date and time if possible.</li>
                    <li>You will receive a tracking number after submitting.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var area = document.getElementById("Description");
            var counter = document.getElementById("descCounter");
            if (!area || !counter) return;

            function update() { counter.textContent = area.value.length; }

            area.addEventListener("input", update);
            if (area.form) {
                area.form.addEventListener("reset", function () { setTimeout(update, 0); });
            }
            update();
        })();
    </script>
}
