@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="display-1 text-danger"><i class="bi bi-exclamation-octagon"></i></div>
    <h2 class="fw-bold mt-3">Something Went Wrong</h2>
    <p class="text-muted">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-2"></i>Back to Home
    </a>
</div>
